{
  "name": "@hoplens/cli",
  "version": "0.1.1",
  "description": "Hoplens CLI — bin `hoplens`. init / doctor / remove.",
  "keywords": ["hoplens", "cli", "nextjs", "devtools", "init"],
  "license": "MIT",
  "author": "Hoplens contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermandinho/hoplens.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/hermandinho/hoplens/issues"
  },
  "homepage": "https://github.com/hermandinho/hoplens/tree/main/packages/cli#readme",
  "type": "commonjs",
  "main": "./dist/cli.js",
  "bin": {
    "hoplens": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@hoplens/transform": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
