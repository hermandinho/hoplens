{
  "name": "@hoplens/transform",
  "version": "0.4.0",
  "description": "Hoplens source transform — rewrites exported functions as traced wrappers without moving a single line.",
  "keywords": ["hoplens", "typescript", "ast", "source-maps", "transform"],
  "license": "MIT",
  "author": "Hoplens contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermandinho/hoplens.git",
    "directory": "packages/transform"
  },
  "bugs": {
    "url": "https://github.com/hermandinho/hoplens/issues"
  },
  "homepage": "https://github.com/hermandinho/hoplens/tree/main/packages/transform#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": "./dist/loader.js",
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./hooks": "./dist/hooks.mjs",
    "./ts": {
      "types": "./dist/ts.d.ts",
      "default": "./dist/ts.js"
    },
    "./cfg": {
      "types": "./dist/cfg.d.ts",
      "default": "./dist/cfg.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runners": "vitest run test/hooks.test.ts test/cjs-layer.test.ts test/generated.test.ts test/cache.test.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "typescript": ">=5.6.0 <7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
