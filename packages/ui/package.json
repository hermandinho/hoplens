{
  "name": "@hoplens/ui",
  "version": "0.1.0",
  "description": "Hoplens UI — Preact + Vite, built to a single inlined HTML file served at /__hoplens.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.html",
  "exports": {
    ".": "./dist/index.html",
    "./index.html": "./dist/index.html",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "echo 'UI tested via Playwright in the e2e workspace — pnpm --filter hoplens-e2e e2e'"
  },
  "engines": { "node": ">=20.9" },
  "dependencies": {
    "preact": "^10.26.4",
    "@preact/signals": "^2.0.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.10.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
