{
  "name": "@hoplens/express",
  "version": "0.3.0",
  "description": "Hoplens adapter for Express 4 and 5 — a register hook and hoplens(app).",
  "keywords": ["hoplens", "express", "adapter", "instrumentation", "devtools"],
  "license": "MIT",
  "author": "Hoplens contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermandinho/hoplens.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/hermandinho/hoplens/issues"
  },
  "homepage": "https://github.com/hermandinho/hoplens/tree/main/packages/express#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./esm/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.mts",
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "esm", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=30000",
    "test:runners": "vitest run --testTimeout=30000 test/functionhops.test.ts test/functionhops-cjs.test.ts test/path.test.ts test/path-flag.test.ts test/path-ts.test.ts test/restart.test.ts test/lifecycle.test.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "peerDependencies": {
    "express": ">=4.18 <6"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "@hoplens/core": "workspace:*",
    "@hoplens/schema": "workspace:*",
    "@hoplens/transform": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "express4": "npm:express@^4.21.2",
    "express5": "npm:express@^5.1.0",
    "ts-node": "10.9.2",
    "tsup": "^8.3.5",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8",
    "zod": "^4.6.7"
  }
}
