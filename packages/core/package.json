{
  "name": "@hoplens/core",
  "version": "0.2.0",
  "description": "Hoplens runtime — framework-agnostic capture, OTel bridge, UI server, source maps, redactor.",
  "keywords": [
    "hoplens",
    "tracing",
    "request-journey",
    "nodejs",
    "opentelemetry",
    "devtools"
  ],
  "license": "MIT",
  "author": "Hoplens contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermandinho/hoplens.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/hermandinho/hoplens/issues"
  },
  "homepage": "https://github.com/hermandinho/hoplens/tree/main/packages/core#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.mjs",
      "require": "./dist/trace.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.mjs",
      "require": "./dist/query.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/benchmark.test.ts\"",
    "bench": "vitest run test/benchmark.test.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@hoplens/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "postgres": "3.4.9",
    "tsup": "^8.3.5",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
