{
  "name": "@hoplens/ui",
  "version": "0.4.0",
  "description": "Hoplens UI — Preact + Vite, built to a single inlined HTML file served at /__hoplens.",
  "keywords": ["hoplens", "ui", "preact", "devtools", "dashboard"],
  "license": "MIT",
  "author": "Hoplens contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermandinho/hoplens.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/hermandinho/hoplens/issues"
  },
  "homepage": "https://github.com/hermandinho/hoplens/tree/main/packages/ui#readme",
  "type": "module",
  "main": "./dist/index.html",
  "exports": {
    ".": "./dist/index.html",
    "./index.html": "./dist/index.html",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "node scripts/check-tokens.mjs && vitest run"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "preact": "^10.26.4",
    "@preact/signals": "^2.0.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.10.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
